# ---------- Server ----------
NODE_ENV=development            # set to "production" when you deploy
PORT=5000
CLIENT_URL=http://localhost:5173  # where the frontend runs (used for CORS and PhonePe return URL)
API_URL=http://localhost:5000     # public URL of this API (PhonePe server callback)
SITE_URL=http://localhost:5173    # public website address, used in sitemap.xml

# ---------- Database (Neon Postgres) ----------
# Neon dashboard > Connection details
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# ---------- Security (REQUIRED in production: 24+ random characters each) ----------
JWT_SECRET=change_me_long_random
JWT_EXPIRES_IN=7d
DOWNLOAD_SECRET=change_me_too

# ---------- Admin ----------
ADMIN_PHONE=+919999999999       # this number becomes the admin when you run `npm run seed`

# ---------- OTP / SMS ----------
OTP_TTL_MIN=5
DEMO_MODE=true                  # true = OTP shown on screen, no SMS sent. MUST be false in production
SMS_PROVIDER=mock               # mock | twilio | msg91 | fast2sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FAST2SMS_KEY=

# ---------- Order confirmation SMS (optional) ----------
SMS_ORDER_CONFIRMATION=false    # true = text the student after payment. Twilio works as is; MSG91/Fast2SMS need the template settings below
MSG91_ORDER_TEMPLATE_ID=
MSG91_ORDER_VARS=amount,link    # names of the two variables in your MSG91 template
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_MESSAGE_ID=

# ---------- PhonePe ----------
PHONEPE_ENV=sandbox             # sandbox | production
# Public sandbox test credentials (replace with your own from the PhonePe dashboard for production)
PHONEPE_MERCHANT_ID=PGTESTPAYUAT86
PHONEPE_SALT_KEY=96434309-7796-489d-8924-ab56988a6076
PHONEPE_SALT_INDEX=1
